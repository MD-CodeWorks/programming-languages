#include <iostream>
using namespace std;

int main(){
    cout << "<--- Bio Data\n";

    char firstLetter;
    cout << "Enter your first letter of your name: ";
    cin >> firstLetter;

    int age;
    cout << "Enter your age: ";
    cin >> age;

    float GPA;
    cout << "Enter your GPA: ";
    cin >> GPA;

    cout << "<--- Your Information --->";
    cout << "Initial: " << firstLetter << " Age: " << age << " years " << "Current GPA: " << GPA;

	return 0;
}








